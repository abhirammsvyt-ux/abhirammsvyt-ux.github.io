{
  "name": "abhiram-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); ['public/project2.png','public/project1.jpg','public/project.jpeg','public/image.jpg.jpeg'].forEach(f => { if(fs.existsSync(f)) fs.unlinkSync(f); })\"",
    "dev": "npm run clean && vite",
    "prebuild": "npm run clean",
    "build": "npm run prebuild && tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.2.11"
  }
}
